{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keviq:events:card:v1",
  "title": "card event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,96}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "ts_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Source time (epoch ms) of what the event describes, not processing time"
    },
    "source": {
      "enum": [
        "replay",
        "facebook",
        "sim"
      ]
    },
    "v": {
      "const": 1
    },
    "caused_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,96}$"
      },
      "description": "event_ids this event is a consequence of (provenance, C1/C6)"
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional stage timestamps (epoch ms) for latency measurement (C8)",
      "properties": {
        "received_ms": {
          "type": "integer",
          "minimum": 0
        },
        "infer_start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "infer_end_ms": {
          "type": "integer",
          "minimum": 0
        },
        "emitted_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "type": {
      "const": "card"
    },
    "card_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,96}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sku": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "price": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Integer amount in `currency` minor-free units (VND has no minor unit); null while still a draft without a spoken price"
    },
    "currency": {
      "const": "VND"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "size": {
            "type": [
              "string",
              "null"
            ]
          },
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "size",
          "color",
          "stock"
        ]
      }
    },
    "stock": {
      "type": "integer",
      "minimum": 0
    },
    "image_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "live",
        "edited",
        "retired"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame_ts_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "speech_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,96}$"
          }
        },
        "edited_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "null = model; 'seller' when a person edited this version"
        }
      },
      "required": [
        "frame_ts_ms",
        "speech_event_ids",
        "edited_by"
      ]
    }
  },
  "required": [
    "event_id",
    "session_id",
    "ts_ms",
    "source",
    "v",
    "type",
    "card_id",
    "version",
    "sku",
    "name",
    "price",
    "currency",
    "variants",
    "stock",
    "image_url",
    "status",
    "provenance"
  ]
}
