{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keviq:events:model_call:v1",
  "title": "model_call event",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,96}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "ts_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Source time (epoch ms) of what the event describes, not processing time"
    },
    "source": {
      "enum": [
        "replay",
        "facebook",
        "sim"
      ]
    },
    "v": {
      "const": 1
    },
    "caused_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,96}$"
      },
      "description": "event_ids this event is a consequence of (provenance, C1/C6)"
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional stage timestamps (epoch ms) for latency measurement (C8)",
      "properties": {
        "received_ms": {
          "type": "integer",
          "minimum": 0
        },
        "infer_start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "infer_end_ms": {
          "type": "integer",
          "minimum": 0
        },
        "emitted_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "type": {
      "const": "model_call"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "tokens_in": {
      "type": "integer",
      "minimum": 0
    },
    "tokens_out": {
      "type": "integer",
      "minimum": 0
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "ok": {
      "type": "boolean"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "units": {
      "type": "object",
      "description": "Non-token billing units, e.g. {\"images\": 1} or {\"audio_seconds\": 60}",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    }
  },
  "required": [
    "event_id",
    "session_id",
    "ts_ms",
    "source",
    "v",
    "type",
    "model",
    "purpose",
    "tokens_in",
    "tokens_out",
    "cost_usd",
    "latency_ms",
    "ok"
  ]
}
