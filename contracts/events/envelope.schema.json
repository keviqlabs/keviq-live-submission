{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keviq:events:envelope:v1",
  "title": "Event envelope (every event carries these fields)",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,96}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "ts_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Source time (epoch ms) of what the event describes, not processing time"
    },
    "source": {
      "enum": [
        "replay",
        "facebook",
        "sim"
      ]
    },
    "v": {
      "const": 1
    },
    "caused_by": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,96}$"
      },
      "description": "event_ids this event is a consequence of (provenance, C1/C6)"
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional stage timestamps (epoch ms) for latency measurement (C8)",
      "properties": {
        "received_ms": {
          "type": "integer",
          "minimum": 0
        },
        "infer_start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "infer_end_ms": {
          "type": "integer",
          "minimum": 0
        },
        "emitted_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "type": {
      "enum": [
        "card",
        "comment",
        "comment_labeled",
        "frame",
        "message_in",
        "message_out",
        "model_call",
        "order",
        "price_proposal",
        "product_seen",
        "speech"
      ]
    }
  },
  "required": [
    "event_id",
    "session_id",
    "ts_ms",
    "source",
    "v",
    "type"
  ]
}
