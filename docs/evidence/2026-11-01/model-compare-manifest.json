 "phases": {
  "spark": "six Spark arms (2 efforts x A, B0, B), frame by frame in run order; cap 2.50 USD",
  "wonder": "wonder-high on B for every frame, then B0 with what is left; total cap 5.00 USD for all arms. A is not run on Wonder: A cannot name SP07/SP09 or SP08/SP10 apart whatever the model sees."
 },
 "cap_rule": "Before a call: spent + unknown + held + 2 x worst-case POST <= cap, else stop. Before every POST (meter check): that POST is held. A logged POST releases its hold; a POST with no reply keeps its worst case as unknown. Worst-case POST = max(1500, 1.2 x max tokens_in seen) x input price + max(floor, 2 x max tokens_out seen) x output price; floors: spark-minimal 1000, spark-high 8000, wonder 8000. The client sends no output limit, so the worst case is an estimate, not a bound.",
 "scoring": {
  "A": "has_product false or category none -> abstain; else production match(category, colour) on the catalog: one item -> pick; several -> cannot_name (collision); none -> cannot_name (no_match)",
  "B0": "state not one_product, or kind khác/none -> abstain; else the one item of that kind and colour",
  "B": "sku SP01..SP10 -> pick (whatever the state); unsure / none -> abstain",
  "verdict": "clear: pick == gold correct, other pick wrong; boundary: pick of either side of the change correct, else wrong; no_product: any pick wrong; abstain, cannot_name and error are counted apart",
  "gated": "production gate shown apart: a pick with confidence < 0.5 becomes an abstain",
  "best": "Among arms that read every manifest frame with at most 5% error rows and abstain or cannot name on at most half of the clear frames: the fewest wrong picks over all frames (ungated); ties -> more correct clear frames; then the lower USD."
 },
