# Copy to deploy/demo/.env (gitignored) and fill in. Fake values only in this file.
# Host port for the app, bound on 127.0.0.1 only; the host's nginx proxies to it. Pick a free one (ss -ltn).
DEMO_APP_PORT=18780
# PostgreSQL password inside the stack (the database is never published): openssl rand -hex 16
DEMO_POSTGRES_PASSWORD=replace-me
# Sessions replayed by `demo.sh seed` / `reset` (folders under data/sessions/, space-separated), how many judge
# slots each, and the replay speed. demo1: product cards and two orders waiting for the seller. ask-variant: orders
# the worker builds without a model; one reaches its receipt, two wait for the customer's yes.
DEMO_SESSIONS=demo1 ask-variant
DEMO_SLOTS=5
DEMO_SEED_SPEED=20
# Leave both empty. The demo refuses to start when either is set.
MODEL_API_KEY=
FACEBOOK_PAGE_TOKEN=
