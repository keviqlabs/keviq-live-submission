# Copy to ../.env (repo root) and fill in real values there. This file holds fake values only.

# Database (local compose)
POSTGRES_PASSWORD=keviq_local_dev
POSTGRES_PORT=55433
DATABASE_URL=postgresql://keviq:keviq_local_dev@127.0.0.1:55433/keviq
# Tests and smoke use <name>_test on the same server (D-016); the name must end in _test.
# TEST_DATABASE_URL=postgresql://keviq:keviq_local_dev@127.0.0.1:55433/keviq_test

# Model API — the real key only ever lives in .env on the Founder's machine
MODEL_API_KEY=replace-me
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_VOICE_WS_URL=wss://api.meta.ai/v1/asr/realtime
MODEL_SPARK=muse-spark-1.3
MODEL_SAM=sam-3.1
MODEL_VOICE=muse-voice-transcribe-1.0
MODEL_IMAGE=muse-image-1.0

# Spend caps (USD). Calls stop when the daily or total cap is reached.
MODEL_DAILY_CAP_USD=30
MODEL_DAILY_WARN_USD=20
MODEL_TOTAL_CAP_USD=300
# Per-session cap and warning (USD), off when unset. Calls in flight when the cap is crossed can go over it.
# MODEL_SESSION_CAP_USD=8
# MODEL_SESSION_WARN_USD=6

# Orders
ORDER_SELLER_THRESHOLD_VND=2000000

# App
APP_PORT=8000

# Facebook, Level 2 (read-only comments of one live video). Real token and video id only in .env.
FACEBOOK_PAGE_TOKEN=replace-me
FACEBOOK_LIVE_VIDEO_ID=000000000000000
FACEBOOK_GRAPH_VERSION=v26.0
FACEBOOK_POLL_SECONDS=2
